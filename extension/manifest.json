{
  "manifest_version": 3,
  "name": "Z’s Download Manager",
  "version": "1.2.0",
  "description": "Send a link to your local Z’s Download Manager app.",
  "permissions": ["contextMenus", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Z’s Download Manager"}
}
